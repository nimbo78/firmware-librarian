# Области знаний (пространства). Файл НЕОБЯЗАТЕЛЕН: без него всё берётся из
# .env как раньше — один продукт, одна папка, один набор чатов.
#
# Заводится так:  cp spaces.toml.example spaces.toml  и правятся id чатов.
# Файл монтируется в оба контейнера (см. docker-compose.yml).
#
# Первая секция — область по умолчанию: в неё попадают чанки и файлы без
# явной метки и всё, что было в базе до появления областей. Переименовывать
# её после запуска нельзя — иначе старые данные окажутся «в другой области»
# (если очень нужно: UPDATE chunks/files/qa_log SET space=... при
# остановленных сервисах, плюс перенос ключей state и пересборка chunks_vec).
#
# Спрашивать по конкретной области: «#b4 почему не поднимается туннель»,
# «#all ...» — искать везде. В своём чате указатель не нужен: бот и так
# отвечает по его области, а если там пусто — сам расширит поиск и скажет
# об этом. В личке бота областей нет, поэтому поиск идёт по всем сразу.

[huawei]
title   = "Huawei"
# «Ты — ассистент telegram-чата <persona>» в системном промпте
persona = "инженеров по оборудованию Huawei"
# терминология области — уходит в расширение запроса (разворот сленга)
hints   = "оборудование Huawei: VRP, CloudEngine, AirEngine, версии V200R0xx"
# чаты-источники знаний: ночной инжест истории (бывший KB_CHAT_IDS)
chats   = [-1001234567890]
# где бот отвечает: "<чат>" или "<чат>:<топик>" (несколько топиков —
# несколько записей). Ключа нет — отвечает во всех чатах из chats;
# answer = [] — не отвечает нигде (режим «только копим знания»)
answer  = ["-1001234567890:15", "-1001234567890:22"]
# папка документов и прошивок этой области (том в docker-compose.yml):
# PDF, архивы и HedEx оттуда попадают в эту же область
folder  = "/app/downloads"
# "huawei" — разбор имён прошивок, /fw, /sw, /download; "none" — выключено
catalog = "huawei"
# что и откуда качает качалка (бывшие CHAT_IDS и FILE_EXTENSIONS)
download = { chats = [-1001234567890], extensions = ["pdf", "zip", "hdx"] }
# куда постить еженедельное «помогите сообществу» (0/не задано — выключено)
gaps_chat  = -1001234567890
gaps_topic = 22
# "home" (по умолчанию) — сначала своя область, потом все; "all" — сразу все
default_scope = "home"

# Область без прошивок: только знания из чата. Ни folder, ни download —
# значит, ни скачивания, ни каталога, ни документных конвейеров.
# answer = [] — бот читает чат, но ничего в нём не пишет; спрашивать про
# эту область можно из любого своего чата указателем «#b4 ...»
#[b4]
#title   = "B4 и обход блокировок"
#persona = "администраторов B4, mihomo и MikroTik"
#hints   = "mihomo, sing-box, RouterOS, WireGuard, DPI, Xray"
#chats   = [-1009876543210]
#answer  = []
#catalog = "none"
