# Скопируй в .env рядом с docker-compose.yml и заполни.
# Значения с дефолтами можно не указывать — тогда возьмутся значения по умолчанию.

# --- Качалка (обязательно) ---

# my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# CSV id чатов, откуда качать файлы (id как видит Telegram, часто отрицательные)
CHAT_IDS=-1001234567890,-1009876543210

# CSV расширений БЕЗ точки (по умолчанию pdf,jpg,png)
FILE_EXTENSIONS=pdf,jpg,png

# --- Общее ---

# Часовой пояс контейнеров; от него зависит INGEST_HOUR (по умолчанию UTC)
TZ=Europe/Moscow

# --- База знаний (не заполнено = подсистема выключена) ---

# Ключ OpenAI: эмбеддинги + ответы бота
OPENAI_API_KEY=sk-...

# CSV чатов-источников знаний (ночной инжест в 5:00 локального времени)
KB_CHAT_IDS=-1001234567890

# Токен бота из BotFather (/newbot). Для реакции на @упоминания
# нужно выключить privacy mode: /setprivacy -> Disable
KB_BOT_TOKEN=1234567890:AAAA-bbbbCCCCddddEEEEffffGGGGhhhhII

# CSV чатов, где бот отвечает на /ask и @упоминания
KB_ANSWER_CHAT_IDS=-1001234567890

# --- Опционально (дефолты в docker-compose.yml) ---

#EMBED_MODEL=text-embedding-3-small
#EMBED_DIM=512
#ANSWER_MODEL=gpt-5-mini
#INGEST_HOUR=5
