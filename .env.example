# Скопируй в .env рядом с docker-compose.yml и заполни.
# Значения с дефолтами можно не указывать — тогда возьмутся значения по умолчанию.

# --- Качалка (обязательно) ---

# my.telegram.org -> API development tools
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# CSV id чатов, откуда качать файлы (id как видит Telegram, часто отрицательные)
CHAT_IDS=-1001234567890,-1009876543210

# CSV расширений БЕЗ точки (по умолчанию pdf,jpg,png)
FILE_EXTENSIONS=pdf,jpg,png

# --- Общее ---

# Часовой пояс контейнеров; от него зависит INGEST_HOUR (по умолчанию UTC)
TZ=Europe/Moscow

# Опциональный MTProto-прокси (telemt/mtg/официальный) для всех подключений
# к Telegram: качалка, kb-bot, бэкфилл. Пусто = напрямую.
# ВАЖНО: секрет — hex или dd+hex; FakeTLS (ee...) Telethon НЕ поддерживает,
# возьми базовый hex-секрет из конфига прокси.
#MTPROXY_HOST=proxy.example.com
#MTPROXY_PORT=443
#MTPROXY_SECRET=dd00112233445566778899aabbccddeeff

# --- База знаний (не заполнено = подсистема выключена) ---

# Ключ OpenAI: эмбеддинги + ответы бота
OPENAI_API_KEY=sk-...

# CSV чатов-источников знаний (ночной инжест в 5:00 локального времени)
KB_CHAT_IDS=-1001234567890

# Токен бота из BotFather (/newbot). Для реакции на @упоминания
# нужно выключить privacy mode: /setprivacy -> Disable
KB_BOT_TOKEN=1234567890:AAAA-bbbbCCCCddddEEEEffffGGGGhhhhII

# CSV чатов, где бот отвечает на /ask и @упоминания
KB_ANSWER_CHAT_IDS=-1001234567890

# CSV telegram user id админов: команды в личке (/status, /events, /notify)
# и уведомления о событиях (скачивания, инжест, стоимость, ошибки).
# Свой id можно узнать у @userinfobot. ВАЖНО: бот не может написать первым —
# после деплоя один раз нажми Start в личке бота.
KB_ADMIN_IDS=123456789

# Еженедельный пост «помогите сообществу — вопросы без ответа» (пн, 10:00).
# Пусто = выключено. KB_GAPS_TOPIC_ID — id топика форума (0 = General).
# Авто-ответ авторам вопросов после ночного инжеста работает независимо
# от этих настроек.
#KB_GAPS_CHAT_ID=-1001234567890
#KB_GAPS_TOPIC_ID=0

# --- Обогащение RAG медиа-контентом (по умолчанию всё выключено) ---
# Результаты кэшируются в базе: повторный бэкфилл не платит дважды.
# Оценить стоимость до запуска: python kb_backfill.py --dry-run

# Картинки через vision-модель: описание + OCR (скриншоты консоли, шильдики).
# ~$0.004 за изображение.
KB_VISION=0

# Голосовые через Whisper: транскрипция. ~$0.006 за минуту. Видео не обрабатываются.
KB_VOICE=0

# Индексация текстового слоя скачанных PDF из папки загрузок (сканы без
# текстового слоя пропускаются). Только стоимость эмбеддингов — копейки.
KB_PDF=0

# Инжест документации Huawei HedEx: .hdx-пакеты кладутся в папку загрузок
# (тот же том, что и файлы качалки). Страницы становятся чанками RAG,
# бот цитирует «документация: продукт версия — раздел». Одинаковые страницы
# разных версий индексируются один раз (от новейшей). Только эмбеддинги:
# полный пакет ~13-15 тыс. страниц — центы на DeepInfra.
KB_HEDEX=0

# Веб-поиск при ответах бота (Responses API + web_search): опыт чата
# приоритетен, веб дополняет/проверяет (доки Huawei, release notes, CVE).
# Веб-источники — отдельным блоком 🌐. ~1-2 цента за вопрос, +5-15 сек.
KB_WEB=0

# --- Опционально (дефолты в docker-compose.yml) ---

# Максимум качества (по бенчмарку kb_bench.py на реальном корпусе, 07.2026):
# BGE-M3 через DeepInfra — +19% MRR к text-embedding-3-large@1024 и в 13 раз
# дешевле ($0.01/1M токенов). Ключ: deepinfra.com -> Dashboard -> API Keys.
#   EMBED_MODEL=BAAI/bge-m3
#   EMBED_DIM=1024
#   EMBED_API_BASE=https://api.deepinfra.com/v1/openai
#   EMBED_API_KEY=...
# EMBED_API_BASE пуст = эмбеддинги через OpenAI (тогда лучший вариант —
# text-embedding-3-large + EMBED_DIM=1024). Ответы/vision/whisper всегда
# идут через OpenAI независимо от эмбеддинг-провайдера.
# ВАЖНО: после смены модели/размерности/провайдера прогнать kb_reembed.py
# (см. README) — вектора разных моделей несравнимы, guard заблокирует KB
# до переэмбеддинга.
#EMBED_MODEL=text-embedding-3-small
#EMBED_DIM=512
#EMBED_API_BASE=
#EMBED_API_KEY=
# Переопределение цены эмбеддингов ($/1M токенов) для оценок бюджета,
# если модель не из встроенной карты цен (small/large/bge-m3)
#EMBED_PRICE_PER_MTOK=
#ANSWER_MODEL=gpt-5-mini
#KB_VISION_MODEL=gpt-5-mini
#INGEST_HOUR=5
